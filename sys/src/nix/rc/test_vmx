#!/bin/rc
#
# Arguments passed to the script are passed to the kernel booted.

# Extracting the plan9.ini configuration to feed to vmx.
# It is a the end of this script, commented. You may adjust.
#
sed -n '/^##BEGIN_INI/,/^##END_INI/p' /bin/nix/vmx \
	| sed -e '/^##/d' -e 's/^#//' \
	>/tmp/$pid.ini

# You must clean up the VMs after running vmx.  We rarely get clean
# exits, so you have to pay attention.  
#

vmx -c /dev/cons -w 1024x768 -m /tmp/$pid.ini $home/nix-os/sys/src/nix/k10/9k8cpu $*

# Clean up
rm -f /tmp/$pid.ini
echo stop >> '#X/0/ctl'
echo quit >> '#X/0/ctl'

exit

